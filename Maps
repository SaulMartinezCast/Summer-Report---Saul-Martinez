library(tidyverse)
library(sf)
library(mapSpain)
library(readxl)
library(stringi)

# === Paths ===
pop_path  <- "C:/Users/Saúl/Documents/2852.xlsx"
cofr_path <- "C:/Users/Saúl/Documents/cofradias_y_hermandades_por_provincia.csv"

# === Helper: robust normalizer for province names ===
normalize_name <- function(x) {
  x %>%
    as.character() %>%
    stringr::str_to_lower() %>%
    stringi::stri_trans_general("Latin-ASCII") %>%
    stringr::str_replace_all("[^a-z0-9]+", "")
}

# === Load mapSpain provinces and harmonize official spellings ===
provinces <- esp_get_prov(moveCAN = TRUE) %>%
  mutate(
    ine.prov.name = case_when(
      ine.prov.name == "Coruña, A"      ~ "A Coruña",
      ine.prov.name == "Rioja, La"      ~ "La Rioja",
      ine.prov.name == "Balears, Illes" ~ "Illes Balears",
      ine.prov.name == "Palmas, Las"    ~ "Las Palmas",
      TRUE ~ ine.prov.name
    )
  )

canon_map <- provinces %>%
  st_drop_geometry() %>%
  distinct(ine_name = ine.prov.name) %>%
  mutate(key = normalize_name(ine_name))

alias_extra <- tibble(
  alias = c(
    "Alava","Araba","Araba/Alava","Vizcaya","Guipuzcoa",
    "Baleares","Balears Illes",
    "Valencia","Valencia/Valencia",
    "Sta. Cruz de Tenerife","Santa Cruz Tenerife",
    "Alicante","Alacant","Alicante/Alacant",
    "Castellon","Castello","Castellon/Castello","Castellón/Castelló",
    "Coruna","Coruña","Coruña A",
    "Rioja","Rioja La",
    "Palmas","Palmas Las"
  ),
  ine_name = c(
    rep("Araba/Álava", 3), "Bizkaia", "Gipuzkoa",
    "Illes Balears", "Illes Balears",
    "Valencia/València", "Valencia/València",
    "Santa Cruz de Tenerife", "Santa Cruz de Tenerife",
    rep("Alicante/Alacant", 3),
    rep("Castellón/Castelló", 4),
    "A Coruña", "A Coruña", "A Coruña",
    "La Rioja", "La Rioja",
    "Las Palmas", "Las Palmas"
  )
) %>%
  mutate(key = normalize_name(alias)) %>%
  select(key, ine_name)

name_map <- bind_rows(alias_extra, canon_map %>% select(key, ine_name)) %>%
  distinct(key, .keep_all = TRUE)

# =========================================================
# 1) Population data
# Actual file structure:
# - header rows at top
# - province names start on row 9
# - only 2 columns
# - year shown in file: 2021
# =========================================================

pop_df <- read_excel(
  pop_path,
  sheet = 1,
  skip = 8,
  col_names = c("provincia_raw", "population")
) %>%
  mutate(
    provincia_raw = as.character(provincia_raw),
    population = suppressWarnings(as.numeric(population))
  ) %>%
  filter(!is.na(provincia_raw), !is.na(population)) %>%
  filter(provincia_raw != "Total") %>%
  mutate(
    provincia_clean = stringr::str_trim(stringr::str_remove(provincia_raw, "^\\d{1,2}\\s+")),
    key = normalize_name(provincia_clean)
  ) %>%
  left_join(name_map, by = "key") %>%
  mutate(provincia = coalesce(ine_name, provincia_clean)) %>%
  select(provincia, population)

# =========================================================
# 2) Cofradías data
# Actual file contains:
# provincia, n_cofradias, n_localidades, n_localidades_con_datos
# There is NO separate hermandades column in the uploaded CSV
# =========================================================

cofr_df <- readr::read_csv(
  cofr_path,
  locale = readr::locale(encoding = "UTF-8"),
  show_col_types = FALSE
) %>%
  mutate(
    provincia = as.character(provincia),
    n_cofradias = as.numeric(n_cofradias),
    key = normalize_name(provincia)
  ) %>%
  left_join(name_map, by = "key") %>%
  mutate(provincia_final = coalesce(ine_name, provincia)) %>%
  group_by(provincia_final) %>%
  summarise(
    n_cofradias = sum(n_cofradias, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  rename(provincia = provincia_final)

# =========================================================
# 3) Merge and create rate
# =========================================================

cofr_pop <- cofr_df %>%
  left_join(pop_df, by = "provincia") %>%
  mutate(
    cofradias_per_100k = 100000 * n_cofradias / population
  )

# Check unmatched provinces
unmatched <- cofr_pop %>% filter(is.na(population))
if (nrow(unmatched) > 0) {
  message("Unmatched provinces in population merge:")
  print(unmatched)
}

# Merge with map
map_data <- provinces %>%
  left_join(cofr_pop, by = c("ine.prov.name" = "provincia"))

# =========================================================
# 4) Plot 1: absolute number of cofradías
# =========================================================

p_abs <- ggplot(map_data) +
  geom_sf(aes(fill = n_cofradias), color = "white", linewidth = 0.2) +
  scale_fill_distiller(
    palette = "RdBu",
    direction = -1,
    na.value = "grey90"
  ) +
  labs(fill = "number of \nbrotherhoods") +
  coord_sf(datum = NA) +
  theme_minimal(base_size = 14) +
  theme(
    legend.position = "right",
    panel.grid.major = element_blank(),
    panel.grid.minor = element_blank()
  )

# =========================================================
# 5) Plot 2: cofradías per 100,000 inhabitants
# =========================================================

p_per100k <- ggplot(map_data) +
  geom_sf(aes(fill = cofradias_per_100k), color = "white", linewidth = 0.2) +
  scale_fill_distiller(
    palette = "RdBu",
    direction = -1,
    na.value = "grey90"
  ) +
  labs(fill = "Cofradías by \n100.000 pop.") +
  coord_sf(datum = NA) +
  theme_minimal(base_size = 14) +
  theme(
    legend.position = "right",
    panel.grid.major = element_blank(),
    panel.grid.minor = element_blank()
  )

print(p_abs)
print(p_per100k)

# =========================================================
# 6) Save high-quality outputs for LaTeX / Beamer
# =========================================================

ggsave(
  filename = "C:/Users/Saúl/Documents/map_cofradias_absolute.pdf",
