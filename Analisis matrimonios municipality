first_existing_ci <- function(df, candidates){
  nm <- names(df)
  m  <- match(tolower(candidates), tolower(nm))
  i  <- which(!is.na(m))[1]
  if (length(i)) nm[m[i]] else NA_character_
}

infer_year <- function(path) {
  b <- basename(path)
  m4 <- str_match(b, "(19|20)\\d{2}")
  if (!all(is.na(m4))) return(as.integer(m4[,1]))
  m2 <- str_match(b, "(\\b|_)(0[8-9]|1[0-9]|2[0-4])(\\b|_)")
  if (!all(is.na(m2))) return(as.integer(paste0("20", m2[,2])))
  NA_integer_
}

# --- Layout -> FWF spec using sheet "Diseño" (VARIABLE + POSICIÓN + LONGITUD) ---
make_fwf_spec_from_layout_disenio <- function(path, sheet = "Diseño") {
  raw <- suppressMessages(readxl::read_excel(
    path, sheet = sheet,
    range = cellranger::cell_limits(c(1,1), c(2000, 30)),
    col_names = FALSE
  ))
  if (nrow(raw) == 0) stop("Layout sheet empty: ", sheet)
  
  h <- NA_integer_
  for (i in 1:min(150, nrow(raw))) {
    hdr <- toupper(as.character(unlist(raw[i, ], use.names = FALSE)))
    hdr[is.na(hdr)] <- ""
    ok_var <- any(str_detect(hdr, regex("^VARIABLE$|NOMBRE|CAMPO|ETIQUETA", TRUE)))
    ok_pos <- any(str_detect(hdr, regex("POSIC", TRUE)))
    ok_len <- any(str_detect(hdr, regex("LONGIT|LONG|ANCHO|TAM|WIDTH", TRUE)))
    if (ok_var && ok_pos && ok_len) { h <- i; break }
  }
  if (is.na(h)) stop("Could not find header row with VARIABLE + POSIC + LONGITUD in sheet: ", sheet)
  
  hdr <- toupper(as.character(unlist(raw[h, ], use.names = FALSE)))
  hdr[is.na(hdr)] <- ""
  
  var_idx <- which(str_detect(hdr, regex("^VARIABLE$|NOMBRE|CAMPO|ETIQUETA", TRUE)))[1]
  pos_idx <- which(str_detect(hdr, regex("POSIC", TRUE)))[1]
  len_idx <- which(str_detect(hdr, regex("LONGIT|LONG|ANCHO|TAM|WIDTH", TRUE)))[1]
  if (any(is.na(c(var_idx, pos_idx, len_idx)))) stop("Header found but indices failed on sheet: ", sheet)
  
  tbl <- raw[(h+1):nrow(raw), , drop = FALSE]
  names(tbl) <- paste0("V", seq_len(ncol(tbl)))
  
  spec <- tbl %>%
    transmute(
      var   = .data[[paste0("V", var_idx)]],
      start = suppressWarnings(as.integer(.data[[paste0("V", pos_idx)]])),
      width = suppressWarnings(as.integer(.data[[paste0("V", len_idx)]]))
    ) %>%
    filter(!is.na(var), !is.na(start), !is.na(width), width > 0) %>%
    mutate(var = toupper(make.names(as.character(var))))
  
  if (!nrow(spec)) stop("Parsed 0 rows for (var,start,width) from sheet: ", sheet)
  
  readr::fwf_positions(
    start = spec$start,
    end   = spec$start + spec$width - 1L,
    col_names = spec$var
  )
}

