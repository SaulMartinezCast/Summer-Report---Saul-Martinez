)

PROV_catholic_couple <- feols(
  Catholic_Marriage ~
    # spouse A main
    exposure_std_A + 
    # spouse B main
    exposure_std_B + 
    # interactions (A × B)
    exposure_std_A:exposure_std_B  |
    prov_birth_code_A + prov_birth_code_B +
    anio_nacimiento_filled_A + anio_nacimiento_filled_B,
