read_one_dat <- function(path) {
  yr <- infer_year(path)
  df <- readr::read_fwf(
    file = path,
    col_positions = fwf_spec,
    col_types = cols(.default = col_character()),
    locale = locale(encoding = "Latin1"),
    progress = TRUE
  ) %>% as_tibble()
  names(df) <- toupper(names(df))
  if (!is.na(yr)) df <- mutate(df, YEAR = yr)
  df
}

