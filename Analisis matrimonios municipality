       "prov_birth_col=", prov_birth_col, "\n",
       "tmes_col=", tmes_col)
}

# ---------------------------------------------------------
# 1) CREATE DERIVED VARIABLES
# ---------------------------------------------------------
microdatos_personas <- microdatos_personas %>%
  mutate(
    ceremony_year = suppressWarnings(as.integer(.data[[ceremony_year_col]])),
    
    by_direct = suppressWarnings(as.integer(.data[[birth_year_col]])),
    age_any   = if (!is.na(age_col)) suppressWarnings(as.integer(.data[[age_col]])) else NA_integer_,
    by_from_ceremony = suppressWarnings(as.integer(if_else(
      !is.na(ceremony_year) & !is.na(age_any),
      ceremony_year - age_any,
      NA_integer_
    ))),
    anio_nacimiento_filled_raw = coalesce(by_direct, by_from_ceremony),
    anio_nacimiento_filled = ifelse(
      !is.na(anio_nacimiento_filled_raw) &
        anio_nacimiento_filled_raw >= 1900 & anio_nacimiento_filled_raw <= 2010,
      anio_nacimiento_filled_raw, NA_integer_
    ),
    
    sex_raw = suppressWarnings(as.integer(.data[[sex_col]])),
    female = case_when(
      sex_raw == 6L ~ 1L,
      sex_raw == 1L ~ 0L,
      TRUE ~ NA_integer_
    ),
    
    Catholic_Marriage = as.integer(suppressWarnings(as.integer(.data[[tipoc_col]])) == 1L),
    
    mun_birth_key = as.character(.data[[mun_key_col]]),
    ceremony_month = if (!is.na(tmes_col)) suppressWarnings(as.integer(.data[[tmes_col]])) else NA_integer_
  ) %>%
  select(-sex_raw, -by_direct, -age_any, -by_from_ceremony, -anio_nacimiento_filled_raw)

# born_in_spain: use prov_birth_code if present, else derive from mun_birth_key
if (!is.na(prov_birth_col) && prov_birth_col %in% names(microdatos_personas)) {
  microdatos_personas <- microdatos_personas %>%
    mutate(
      prov_birth_code = as.character(.data[[prov_birth_col]]),
      born_in_spain = prov_birth_code %in% sprintf("%02d", 1:52)
    )
} else {
  microdatos_personas <- microdatos_personas %>%
    mutate(
      prov_birth_code = ifelse(!is.na(mun_birth_key),
                               sprintf("%02d", as.integer(substr(mun_birth_key, 1, 2))),
                               NA_character_),
      born_in_spain = prov_birth_code %in% sprintf("%02d", 1:52)
    )
}

# ---------------------------------------------------------
# 2) FOREIGN_COUPLE (spouse not born in Spain) — SAFE JOIN
# ---------------------------------------------------------
setDT(microdatos_personas)
stopifnot("marriage_id" %in% names(microdatos_personas))
stopifnot("conyuge" %in% names(microdatos_personas))
stopifnot("born_in_spain" %in% names(microdatos_personas))

sp <- microdatos_personas[, .(
  marriage_id,
  conyuge = as.character(conyuge),
  spouse_born_in_spain = born_in_spain
)]
sp[, conyuge := fifelse(conyuge == "A", "B", "A")]

setkey(microdatos_personas, marriage_id, conyuge)
setkey(sp, marriage_id, conyuge)

microdatos_personas <- sp[microdatos_personas]

microdatos_personas[, foreign_couple :=
                      fifelse(is.na(spouse_born_in_spain), NA_integer_,
                              fifelse(spouse_born_in_spain, 0L, 1L))
]

setDF(microdatos_personas)

# ---------------------------------------------------------
# 3) BUILD FINAL MODEL DATA
# Spain-born only in all regressions
# ---------------------------------------------------------
model_data_clean <- microdatos_personas %>%
  filter(
    born_in_spain,
    !is.na(childhood_total_dry_days_mun),
    !is.na(childhood_total_dry_days_mun_std),
    !is.na(mun_birth_key),
    !is.na(anio_nacimiento_filled),
    !is.na(female),
    !is.na(Catholic_Marriage),
    !is.na(prov_birth_code)
  ) %>%
  mutate(
    prov_birth_code = as.character(prov_birth_code),
    marriage_id     = as.character(marriage_id),
    exposure_std    = childhood_total_dry_days_mun_std,
    exposure_std_sq = exposure_std^2
  )

cat("Clean analysis sample size (individual sample, Spain-born only):", nrow(model_data_clean), "\n")

# ---------------------------------------------------------
# 4A) INDIVIDUAL OUTCOME (person level)
# Province of birth added as control
# ---------------------------------------------------------
MUN_army <- feols(
  army ~ exposure_std + female + factor(prov_birth_code) |
    mun_birth_key + anio_nacimiento_filled,
  data    = model_data_clean,
  cluster = ~ mun_birth_key
)

# ---------------------------------------------------------
# 4B) COUPLE-LEVEL DATA FOR CATHOLIC MARRIAGE
# Keep ONLY mixed-sex couples, Spain-born only
# ---------------------------------------------------------
mixed_sex_ids <- model_data_clean %>%
  group_by(marriage_id) %>%
  summarise(
    has_A = any(conyuge == "A"),
    has_B = any(conyuge == "B"),
    is_mixed_sex = (any(female == 1L, na.rm = TRUE) & any(female == 0L, na.rm = TRUE)),
    .groups = "drop"
  ) %>%
  filter(has_A, has_B, is_mixed_sex) %>%
  pull(marriage_id)

cat("Mixed-sex couples:", length(mixed_sex_ids), "\n")

couple_data <- model_data_clean %>%
  filter(marriage_id %in% mixed_sex_ids) %>%
  select(
    marriage_id,
    conyuge,
    Catholic_Marriage,
    exposure_std,
    exposure_std_sq,
    mun_birth_key,
    prov_birth_code,
    anio_nacimiento_filled,
    ceremony_year,
    ceremony_month
  ) %>%
  pivot_wider(
    id_cols = marriage_id,
    names_from = conyuge,
    values_from = c(
      exposure_std, exposure_std_sq,
      mun_birth_key, prov_birth_code,
      anio_nacimiento_filled
    )
  ) %>%
  left_join(
    model_data_clean %>%
      filter(marriage_id %in% mixed_sex_ids) %>%
      distinct(marriage_id, Catholic_Marriage, ceremony_year, ceremony_month),
    by = "marriage_id"
  )

couple_data <- couple_data %>%
  filter(
    !is.na(exposure_std_A), !is.na(exposure_std_B),
    !is.na(mun_birth_key_A), !is.na(mun_birth_key_B),
    !is.na(prov_birth_code_A), !is.na(prov_birth_code_B),
    !is.na(anio_nacimiento_filled_A), !is.na(anio_nacimiento_filled_B),
    !is.na(Catholic_Marriage)
  )

cat("Couple sample size (mixed-sex, Spain-born only, usable):", nrow(couple_data), "\n")

# ---------------------------------------------------------
# 4C) Catholic Marriage — Couple-Level Regression (A,B + A×B)
# Province of birth for both spouses added as controls
# ---------------------------------------------------------
MUN_catholic_couple <- feols(
  Catholic_Marriage ~
    exposure_std_A +
    exposure_std_B +
    exposure_std_A:exposure_std_B +
    factor(prov_birth_code_A) +
    factor(prov_birth_code_B) |
    mun_birth_key_A + mun_birth_key_B +
    anio_nacimiento_filled_A + anio_nacimiento_filled_B,
  data    = couple_data,
  cluster = ~ mun_birth_key_A + mun_birth_key_B
)

# ---------------------------------------------------------
# 4D) Couple-level "common exposure": (raw_A + raw_B) then standardize
# ---------------------------------------------------------
mu_raw <- mean(model_data_clean$childhood_total_dry_days_mun, na.rm = TRUE)
sd_raw <- sd(model_data_clean$childhood_total_dry_days_mun, na.rm = TRUE)
stopifnot(is.finite(mu_raw), is.finite(sd_raw), sd_raw > 0)

couple_data <- couple_data %>%
  mutate(
    exposure_raw_A   = exposure_std_A * sd_raw + mu_raw,
    exposure_raw_B   = exposure_std_B * sd_raw + mu_raw,
    exposure_raw_sum = exposure_raw_A + exposure_raw_B,
    exposure_sum_std = as.numeric(scale(exposure_raw_sum))
  )

MUN_catholic_couple_sum <- feols(
  Catholic_Marriage ~ exposure_sum_std +
    factor(prov_birth_code_A) +
    factor(prov_birth_code_B) |
    mun_birth_key_A + mun_birth_key_B +
    anio_nacimiento_filled_A + anio_nacimiento_filled_B,
  data    = couple_data,
  cluster = ~ mun_birth_key_A + mun_birth_key_B +
    anio_nacimiento_filled_A + anio_nacimiento_filled_B
)

# ---------------------------------------------------------
# OUTPUTS
# ---------------------------------------------------------
modelsummary(
  list(
    "Army (Mun FE)"                = MUN_army,
    "Catholic (Couple: A,B + A×B)" = MUN_catholic_couple
  ),
  output = "latex",
  stars = c("*"=.10, "**"=.05, "***"=.01),
  coef_rename = c(
    "exposure_std"      = "Dry days (std)",
    "exposure_std_A"    = "Dry days A",
    "exposure_std_B"    = "Dry days B",
    "exposure_std_A:exposure_std_B" = "A $\\times$ B",
    "exposure_sum_std"  = "Dry days (A+B, std)",
    "female"            = "Female"
  ),
  coef_omit = "ceremony_month|prov_birth_code"
)

# ---------------------------------------------------------
# 5) ROBUSTNESS — Province FE (NO year_cm)
# Changes:
#  - Individual: multiway clustering province + cohort + marriage_id
#  - Couple: multiway clustering prov_A + prov_B + cohort_A + cohort_B
# ---------------------------------------------------------

PROV_army <- feols(
