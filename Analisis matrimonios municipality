plot_dist_quartiles <- function(df, x, qvar, title, binwidth = NULL) {
  df <- df %>% filter(!is.na(.data[[x]]), !is.na(.data[[qvar]]))
  
  ranges <- df %>%
    group_by(.data[[qvar]]) %>%
    summarise(
      xmin = min(.data[[x]], na.rm = TRUE),
      xmax = max(.data[[x]], na.rm = TRUE),
      .groups = "drop"
    ) %>%
    arrange(xmin) %>%
    mutate(Q = factor(paste0("Q", row_number()), levels = paste0("Q", 1:4)))
  
  if (is.null(binwidth)) {
    # heuristic (works for std exposure and for sums)
    binwidth <- (quantile(df[[x]], 0.95, na.rm=TRUE) - quantile(df[[x]], 0.05, na.rm=TRUE)) / 35
  }
  
  ggplot(df, aes(x = .data[[x]])) +
    geom_rect(
      data = ranges,
      aes(xmin = xmin, xmax = xmax, ymin = -Inf, ymax = Inf, fill = Q),
      inherit.aes = FALSE, alpha = 0.15
    ) +
    geom_histogram(aes(y = after_stat(density)),
                   binwidth = binwidth, fill = "grey80", color = "white", alpha = 0.9) +
    geom_density(color = "black", linewidth = 0.8) +
    scale_fill_brewer(palette = "Set2", name = NULL) +
    labs(x = x, y = "Density", title = title) +
    theme_minimal()
}

